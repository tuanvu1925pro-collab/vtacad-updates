;;; ==========================================================================
;;;  VTACAD PRO SINGLE-FILE SELF-INSTALLER v26.0
;;;  APPLOAD / Drag-and-Drop this file into AutoCAD once:
;;;   - Verifies integrity & auto-upgrades older installs (FAS+CUIX+Tools+XML)
;;;   - Dual-fallback extraction: PowerShell Expand-Archive + COM Shell
;;;   - Dual-fallback Tools deployment: certutil + .NET Base64 PowerShell
;;;   - Registers ACAD Support Path & TRUSTEDPATHS automatically
;;;   - Unloads stale ribbon / cleans .mnr caches / reloads VTACAD.cuix
;;;   - Commands: VTA_PRO, VTA_SETUP (DCL), VTA_DIAG, VTA_REPAIR, VTA_REINSTALL
;;; ==========================================================================
(vl-load-com)

;;; --- 1. CONSTANTS & VERSION / INTEGRITY CHECKING --------------------------
(setq *VTA:Setup:Version* "26.3.20261120")
(setq *VTA:Setup:ExpectedFasSize* 162647)
(setq *VTA:Setup:ExpectedCuixSize* 22855)
(setq *VTA:Setup:ExpectedToolsSize* 247854)
(setq *VTA:Setup:ExpectedBmpCount* 60)

(defun VTA:Setup:RegKey ()
  "HKEY_CURRENT_USER\\Software\\VTAcad\\Setup"
)

(defun VTA:Setup:AppDataBundle (/ appData)
  (setq appData (getenv "APPDATA"))
  (if (and appData (/= appData ""))
    (strcat (vl-string-right-trim "\\" (vl-string-translate "/" "\\" appData))
            "\\Autodesk\\ApplicationPlugins\\VTACAD.bundle")
  )
)

(defun VTA:Setup:CountBmp (dir / files cnt)
  (setq cnt 0)
  (if (and dir (vl-file-directory-p dir))
    (progn
      (setq files (vl-directory-files dir "*.bmp" 1))
      (if files (setq cnt (length files)))
    )
  )
  cnt
)

(defun VTA:Setup:NeedInstallP (bundleDir contentsDir / eng cuix tools xml regVer fasSize cuixSize toolsSize bmpCnt)
  (if (and bundleDir contentsDir)
    (progn
      (setq eng   (strcat contentsDir "\\VTACAD.fas"))
      (setq cuix  (strcat contentsDir "\\VTACAD.cuix"))
      (setq tools (strcat contentsDir "\\VTACAD_Tools.fas"))
      (setq xml   (strcat bundleDir "\\PackageContents.xml"))
      (if (and (findfile eng) (findfile cuix) (findfile tools) (findfile xml))
        (progn
          (setq fasSize   (vl-file-size eng))
          (setq cuixSize  (vl-file-size cuix))
          (setq toolsSize (vl-file-size tools))
          (setq bmpCnt    (VTA:Setup:CountBmp contentsDir))
          (setq regVer    (vl-catch-all-apply 'vl-registry-read (list (VTA:Setup:RegKey) "InstalledVersion")))
          (if (vl-catch-all-error-p regVer) (setq regVer nil))
          (not
            (and
              (equal fasSize *VTA:Setup:ExpectedFasSize*)
              (equal cuixSize *VTA:Setup:ExpectedCuixSize*)
              (equal toolsSize *VTA:Setup:ExpectedToolsSize*)
              (>= bmpCnt *VTA:Setup:ExpectedBmpCount*)
              (equal regVer *VTA:Setup:Version*)
            )
          )
        )
        T
      )
    )
    T
  )
)

;;; --- 2. STRING / PATH HELPERS & TRUSTED / SUPPORT PATH REGISTRATION -------
(defun VTA:Setup:ReplaceAll (str old new / pos out oldLen prefix)
  (setq out "")
  (if (and str (= (type str) 'STR) old (= (type old) 'STR) (> (strlen old) 0))
    (progn
      (setq oldLen (strlen old))
      (while (setq pos (vl-string-search old str))
        (setq prefix (if (> pos 0) (substr str 1 pos) ""))
        (setq out (strcat out prefix new))
        (setq str (substr str (+ pos oldLen 1)))
      )
      (strcat out str)
    )
    (if str str "")
  )
)

(defun VTA:Setup:StrSplit (str delim / pos res dLen part)
  (setq res nil)
  (if (and str (= (type str) 'STR) delim (= (type delim) 'STR) (> (strlen delim) 0))
    (progn
      (setq dLen (strlen delim))
      (while (setq pos (vl-string-search delim str))
        (setq part (if (> pos 0) (substr str 1 pos) ""))
        (setq res (cons part res))
        (setq str (substr str (+ pos dLen 1)))
      )
      (setq res (reverse (cons str res)))
    )
  )
  res
)

(defun VTA:Setup:NormPath (p / n)
  (if (and p (= (type p) 'STR))
    (progn
      (setq n (vl-string-trim " \t\r\n" p))
      (setq n (vl-string-translate "/" "\\" n))
      (setq n (vl-string-right-trim "\\" n))
      (strcase n)
    )
    ""
  )
)

(defun VTA:Setup:HasPathP (pathStr target / tgtNorm parts found item)
  (setq tgtNorm (VTA:Setup:NormPath target))
  (if (and pathStr (= (type pathStr) 'STR) (/= tgtNorm ""))
    (progn
      (setq parts (VTA:Setup:StrSplit pathStr ";"))
      (foreach item parts
        (if (= (VTA:Setup:NormPath item) tgtNorm)
          (setq found T)
        )
      )
    )
  )
  found
)

(defun VTA:Setup:AppendPath (pathStr target / clean)
  (if (and pathStr (= (type pathStr) 'STR))
    (setq clean (vl-string-right-trim ";" pathStr))
    (setq clean "")
  )
  (if (= clean "")
    target
    (strcat clean ";" target)
  )
)

(defun VTA:Setup:EnsurePaths (bundleDir contentsDir / acadPath newAcad tp tpNew tpChanged trustedSub)
  (if (and bundleDir contentsDir)
    (progn
      (setq acadPath (getenv "ACAD"))
      (if (null acadPath) (setq acadPath ""))
      (if (not (VTA:Setup:HasPathP acadPath contentsDir))
        (progn
          (setq newAcad (VTA:Setup:AppendPath acadPath contentsDir))
          (vl-catch-all-apply 'setenv (list "ACAD" newAcad))
        )
      )
      (setq tp (vl-catch-all-apply 'getvar (list "TRUSTEDPATHS")))
      (if (and (not (vl-catch-all-error-p tp)) (= (type tp) 'STR))
        (progn
          (setq tpNew tp)
          (setq tpChanged nil)
          (setq trustedSub (strcat bundleDir "\\..."))
          (if (not (VTA:Setup:HasPathP tpNew contentsDir))
            (progn
              (setq tpNew (VTA:Setup:AppendPath tpNew contentsDir))
              (setq tpChanged T)
            )
          )
          (if (not (VTA:Setup:HasPathP tpNew trustedSub))
            (progn
              (setq tpNew (VTA:Setup:AppendPath tpNew trustedSub))
              (setq tpChanged T)
            )
          )
          (if tpChanged
            (vl-catch-all-apply 'setvar (list "TRUSTEDPATHS" tpNew))
          )
        )
      )
    )
  )
  T
)

;;; --- 3. SAFE MENU UNLOAD, MNR CACHE CLEANUP & RIBBON RELOAD ---------------
(defun VTA:Setup:UnloadRibbon (contentsDir / oldFdia oldEcho mnr1 mnr2)
  (if (menugroup "VTACAD")
    (progn
      (setq oldFdia (getvar "FILEDIA")
            oldEcho (getvar "CMDECHO"))
      (vl-catch-all-apply
        '(lambda ()
           (setvar "FILEDIA" 0)
           (setvar "CMDECHO" 0)
           (vl-catch-all-apply
             '(lambda (/ acadObj mg)
                (setq acadObj (vlax-get-acad-object))
                (if acadObj
                  (progn
                    (setq mg (vla-item (vla-get-menugroups acadObj) "VTACAD"))
                    (if mg (vla-unload mg))
                  )
                )
              )
           )
           (if (menugroup "VTACAD")
             (progn
               (vl-cmdf "_.CUIUNLOAD" "VTACAD")
               (while (> (getvar "CMDACTIVE") 0) (vl-cmdf ""))
             )
           )
         )
      )
      (vl-catch-all-apply
        '(lambda ()
           (if oldFdia (setvar "FILEDIA" oldFdia))
           (if oldEcho (setvar "CMDECHO" oldEcho))
         )
      )
    )
  )
  (if (and contentsDir (= (type contentsDir) 'STR))
    (progn
      (setq mnr1 (strcat contentsDir "\\VTACAD.mnr"))
      (setq mnr2 (strcat contentsDir "\\VTACAD_light.mnr"))
      (if (findfile mnr1) (vl-catch-all-apply 'vl-file-delete (list mnr1)))
      (if (findfile mnr2) (vl-catch-all-apply 'vl-file-delete (list mnr2)))
    )
  )
  (princ)
)

(defun VTA:Setup:ReloadRibbon (cuix / oldFdia oldEcho)
  (setq oldFdia (getvar "FILEDIA")
        oldEcho (getvar "CMDECHO"))
  (vl-catch-all-apply
    '(lambda ()
       (setvar "FILEDIA" 0)
       (setvar "CMDECHO" 0)
       (if (and (not (menugroup "VTACAD")) cuix (findfile cuix))
         (progn
           (vl-cmdf "_.CUILOAD" cuix)
           (while (> (getvar "CMDACTIVE") 0) (vl-cmdf ""))
         )
       )
     )
  )
  (vl-catch-all-apply
    '(lambda ()
       (if oldFdia (setvar "FILEDIA" oldFdia))
       (if oldEcho (setvar "CMDECHO" oldEcho))
     )
  )
  (princ)
)

;;; --- 4. DUAL-FALLBACK PAYLOAD EXTRACTION, TOOLS DEPLOY & AUTOLOADER XML ---
(defun VTA:Setup:PSRun (cmd / wsh res)
  (setq wsh (vl-catch-all-apply 'vlax-create-object (list "WScript.Shell")))
  (if (and wsh (not (vl-catch-all-error-p wsh)))
    (progn
      (setq res (vl-catch-all-apply 'vlax-invoke-method (list wsh 'Run cmd 0 :vlax-true)))
      (vl-catch-all-apply 'vlax-release-object (list wsh))
      res
    )
  )
)

(defun VTA:Setup:EnsureDir (dirPath / clean parts cur rest item)
  (if (and dirPath (= (type dirPath) 'STR) (/= dirPath ""))
    (progn
      (setq clean (vl-string-right-trim "\\" (vl-string-translate "/" "\\" dirPath)))
      (cond
        ((wcmatch clean "?:*")
         (setq cur (substr clean 1 2))
         (setq rest (if (> (strlen clean) 3) (substr clean 4) ""))
         (setq parts (VTA:Setup:StrSplit rest "\\"))
        )
        ((= (substr clean 1 2) "\\\\")
         (setq parts (VTA:Setup:StrSplit (substr clean 3) "\\"))
         (if (>= (length parts) 2)
           (progn
             (setq cur (strcat "\\\\" (car parts) "\\" (cadr parts)))
             (setq parts (cddr parts))
           )
           (progn
             (setq cur clean)
             (setq parts nil)
           )
         )
        )
        (T
         (setq cur "")
         (setq parts (VTA:Setup:StrSplit clean "\\"))
        )
      )
      (foreach item parts
        (if (/= item "")
          (progn
            (setq cur (if (= cur "") item (strcat cur "\\" item)))
            (if (not (vl-file-directory-p cur))
              (vl-mkdir cur)
            )
          )
        )
      )
      (vl-file-directory-p clean)
    )
  )
)

(defun VTA:Setup:WriteB64Chunks (filePath b64Str / f pos totalLen ok)
  (if (and filePath (= (type filePath) 'STR) b64Str (= (type b64Str) 'STR) (> (strlen b64Str) 0))
    (progn
      (setq f (open filePath "w"))
      (if f
        (progn
          (setq pos 1
                totalLen (strlen b64Str))
          (while (<= pos totalLen)
            (write-line (substr b64Str pos 4000) f)
            (setq pos (+ pos 4000))
          )
          (close f)
          (setq ok T)
        )
      )
    )
  )
  ok
)

(defun VTA:Setup:WriteXML (path / f)
  (setq f (open path "w"))
  (if f
    (progn
      (write-line "<?xml version=\"1.0\" encoding=\"utf-8\"?>" f)
      (write-line "<ApplicationPackage SchemaVersion=\"1.0\" AppVersion=\"26.0\" Author=\"VTAcad\" Description=\"VTACAD PRO MASTER SUITE\" Name=\"VTACAD PRO\">" f)
      (write-line "  <CompanyDetails Name=\"VTAcad Pro\" />" f)
      (write-line "  <Components Description=\"VTACAD Core Components\">" f)
      (write-line "    <RuntimeRequirements OS=\"Win64\" Platform=\"AutoCAD\" SeriesMin=\"R19.0\" SeriesMax=\"R26.0\" SupportPath=\"./Contents\" />" f)
      (write-line "    <ComponentEntry AppName=\"VTACAD_Engine\" ModuleName=\"Contents\\VTACAD.fas\" AppDescription=\"VTACAD Engine (compiled)\" LoadOnCommandInvocation=\"False\" LoadOnAutoCADStartup=\"True\" />" f)
      (write-line "    <ComponentEntry AppName=\"VTACAD_Tools\" ModuleName=\"Contents\\VTACAD_Tools.fas\" AppDescription=\"VTACAD Pro v26.0 Advanced Tools (QA, QS, Font, Dashboard)\" LoadOnCommandInvocation=\"False\" LoadOnAutoCADStartup=\"True\" />" f)
      (write-line "  </Components>" f)
      (write-line "</ApplicationPackage>" f)
      (close f)
      T
    )
  )
)

(defun VTA:Setup:ExtractZipCOM (zipPath destDir / sh zNorm dNorm srcFolder dstFolder items)
  (if (and zipPath (= (type zipPath) 'STR) destDir (= (type destDir) 'STR))
    (progn
      ;; Shell.Application NameSpace requires Windows backslashes with no trailing backslash
      (setq zNorm (vl-string-right-trim "\\" (vl-string-translate "/" "\\" zipPath)))
      (setq dNorm (vl-string-right-trim "\\" (vl-string-translate "/" "\\" destDir)))
      (setq sh (vl-catch-all-apply 'vlax-create-object (list "Shell.Application")))
      (if (and sh (not (vl-catch-all-error-p sh)))
        (progn
          (vl-catch-all-apply
            '(lambda ()
               (setq srcFolder (vlax-invoke-method sh 'NameSpace zNorm))
               (setq dstFolder (vlax-invoke-method sh 'NameSpace dNorm))
               (if (and srcFolder dstFolder)
                 (progn
                   (setq items (vlax-invoke-method srcFolder 'Items))
                   (if items
                     (vlax-invoke-method dstFolder 'CopyHere items 20)
                   )
                   (if items (vl-catch-all-apply 'vlax-release-object (list items)))
                 )
               )
               (if dstFolder (vl-catch-all-apply 'vlax-release-object (list dstFolder)))
               (if srcFolder (vl-catch-all-apply 'vlax-release-object (list srcFolder)))
             )
          )
          (vl-catch-all-apply 'vlax-release-object (list sh))
        )
      )
    )
  )
)

(defun VTA:Setup:ExtractPayload (bundleDir contentsDir / tempDir b64 zip eng cuix xml psZip psDst ok)
  (setq tempDir (vl-string-right-trim "\\" (vl-string-translate "/" "\\" (cond ((getenv "TEMP")) ((getenv "TMP")) (T "C:\\Temp")))))
  (VTA:Setup:EnsureDir tempDir)
  (VTA:Setup:EnsureDir contentsDir)
  (setq b64 (strcat tempDir "\\vta_setup.b64"))
  (setq zip (strcat tempDir "\\vta_setup.zip"))
  (setq eng (strcat contentsDir "\\VTACAD.fas"))
  (setq cuix (strcat contentsDir "\\VTACAD.cuix"))
  (setq xml (strcat bundleDir "\\PackageContents.xml"))
  (if (findfile b64) (vl-file-delete b64))
  (if (findfile zip) (vl-file-delete zip))
  (if (and *VTA:Setup:Payload* (> (strlen *VTA:Setup:Payload*) 0))
    (VTA:Setup:WriteB64Chunks b64 *VTA:Setup:Payload*)
  )
  (if (findfile b64)
    (VTA:Setup:PSRun (strcat "certutil -f -decode \"" b64 "\" \"" zip "\""))
  )
  (if (and (findfile zip) (> (vl-file-size zip) 0))
    (progn
      (if (findfile eng) (vl-catch-all-apply 'vl-file-delete (list eng)))
      (if (findfile cuix) (vl-catch-all-apply 'vl-file-delete (list cuix)))
      (setq psZip (VTA:Setup:ReplaceAll zip "'" "''"))
      (setq psDst (VTA:Setup:ReplaceAll contentsDir "'" "''"))
      (VTA:Setup:PSRun
        (strcat "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Expand-Archive -LiteralPath '" psZip "' -DestinationPath '" psDst "' -Force\"")
      )
      (if (not (and (findfile eng)
                    (equal (vl-file-size eng) *VTA:Setup:ExpectedFasSize*)
                    (findfile cuix)
                    (equal (vl-file-size cuix) *VTA:Setup:ExpectedCuixSize*)
                    (>= (VTA:Setup:CountBmp contentsDir) *VTA:Setup:ExpectedBmpCount*)))
        (VTA:Setup:ExtractZipCOM zip contentsDir)
      )
      (if (and (findfile eng)
               (equal (vl-file-size eng) *VTA:Setup:ExpectedFasSize*)
               (findfile cuix)
               (equal (vl-file-size cuix) *VTA:Setup:ExpectedCuixSize*)
               (>= (VTA:Setup:CountBmp contentsDir) *VTA:Setup:ExpectedBmpCount*))
        (progn
          (VTA:Setup:WriteXML xml)
          (setq ok T)
        )
      )
    )
  )
  (if (findfile b64) (vl-file-delete b64))
  (if (findfile zip) (vl-file-delete zip))
  ok
)

(defun VTA:Setup:DeployTools (contentsDir / tempDir b64 toolsPath oldLsp psB64 psTools ok)
  (setq tempDir (vl-string-right-trim "\\" (vl-string-translate "/" "\\" (cond ((getenv "TEMP")) ((getenv "TMP")) (T "C:\\Temp")))))
  (VTA:Setup:EnsureDir tempDir)
  (VTA:Setup:EnsureDir contentsDir)
  (setq b64 (strcat tempDir "\\vta_tools.b64"))
  (setq toolsPath (strcat contentsDir "\\VTACAD_Tools.fas"))
  (if (findfile b64) (vl-catch-all-apply 'vl-file-delete (list b64)))
  (if (findfile toolsPath) (vl-catch-all-apply 'vl-file-delete (list toolsPath)))
  (setq oldLsp (strcat contentsDir "\\VTACAD_Tools.lsp"))
  (if (findfile oldLsp) (vl-catch-all-apply 'vl-file-delete (list oldLsp)))
  (if (and *VTA:Setup:ToolsPayload* (> (strlen *VTA:Setup:ToolsPayload*) 0))
    (VTA:Setup:WriteB64Chunks b64 *VTA:Setup:ToolsPayload*)
  )
  (if (findfile b64)
    (progn
      (VTA:Setup:PSRun (strcat "certutil -f -decode \"" b64 "\" \"" toolsPath "\""))
      (if (not (and (findfile toolsPath)
                    (equal (vl-file-size toolsPath) *VTA:Setup:ExpectedToolsSize*)))
        (progn
          (setq psB64 (VTA:Setup:ReplaceAll b64 "'" "''"))
          (setq psTools (VTA:Setup:ReplaceAll toolsPath "'" "''"))
          (VTA:Setup:PSRun
            (strcat "powershell -NoProfile -ExecutionPolicy Bypass -Command \"[IO.File]::WriteAllBytes('" psTools "', [Convert]::FromBase64String([IO.File]::ReadAllText('" psB64 "')))\"")
          )
        )
      )
    )
  )
  (if (findfile b64) (vl-catch-all-apply 'vl-file-delete (list b64)))
  (if (and (findfile toolsPath)
           (equal (vl-file-size toolsPath) *VTA:Setup:ExpectedToolsSize*))
    (setq ok T)
  )
  ok
)

;;; --- 5. INSTALLER FLOW, ADMIN COMMANDS & ANSI DCL MANAGER -----------------
(defun VTA:Setup:Install (force / bundleDir contentsDir eng cuix toolsPath xml ok)
  (setq bundleDir (VTA:Setup:AppDataBundle))
  (if (null bundleDir)
    (princ "\n[VTACAD][ERR] Cannot resolve %APPDATA% - install aborted.")
    (progn
      (setq contentsDir (strcat bundleDir "\\Contents"))
      (setq eng (strcat contentsDir "\\VTACAD.fas"))
      (setq cuix (strcat contentsDir "\\VTACAD.cuix"))
      (setq toolsPath (strcat contentsDir "\\VTACAD_Tools.fas"))
      (setq xml (strcat bundleDir "\\PackageContents.xml"))
      (if (or force (VTA:Setup:NeedInstallP bundleDir contentsDir))
        (progn
          (princ (if force
                   "\n[VTACAD] Reinstalling VTACAD PRO v26.3 (FAS + CUIX + 60 Icons + Tools)..."
                   "\n[VTACAD] Installing / upgrading VTACAD PRO v26.3..."
                 )
          )
          (VTA:Setup:UnloadRibbon contentsDir)
          (VTA:Setup:ExtractPayload bundleDir contentsDir)
          (VTA:Setup:DeployTools contentsDir)
          (if (and (findfile eng)
                   (equal (vl-file-size eng) *VTA:Setup:ExpectedFasSize*)
                   (findfile cuix)
                   (equal (vl-file-size cuix) *VTA:Setup:ExpectedCuixSize*)
                   (findfile toolsPath)
                   (equal (vl-file-size toolsPath) *VTA:Setup:ExpectedToolsSize*)
                   (>= (VTA:Setup:CountBmp contentsDir) *VTA:Setup:ExpectedBmpCount*)
                   (VTA:Setup:WriteXML xml))
            (progn
              (VTA:Setup:EnsurePaths bundleDir contentsDir)
              (VTA:Setup:ReloadRibbon cuix)
              (vl-catch-all-apply 'vl-registry-write (list (VTA:Setup:RegKey) "InstalledVersion" *VTA:Setup:Version*))
              (vl-catch-all-apply 'vl-registry-write (list (VTA:Setup:RegKey) "BundleDir" bundleDir))
              (vl-catch-all-apply 'load (list eng))
              (vl-catch-all-apply 'load (list toolsPath))
              (setq ok T)
              (princ "\n==================================================================")
              (princ "\n[VTACAD] INSTALL / UPGRADE COMPLETE (v26.3.20261120)!")
              (princ "\n - Engine FAS + Ribbon CUIX + 60 BMP Icons + Tools FAS verified.")
              (princ "\n - Autoloader (2 entries) + ACAD + TRUSTEDPATHS configured.")
              (princ "\n - Core     : VTA (Panel), VTA_PRO (Advanced Hub)")
              (princ "\n - QA/Diff  : SOILOI (XOAQA), SOSANH (XOADIFF)")
              (princ "\n - Ket cau  : VEDAM (VTA_VEDAM)")
              (princ "\n - QS/DMBV  : QSCOT, QSTUONG, DMBV")
              (princ "\n - Font/Dash: DOIFONT, SUAFONT, BAOCAO")
              (princ "\n - Admin    : VTA_SETUP, VTA_DIAG, VTA_REPAIR, CAPNHAT")
              (princ "\n==================================================================")
            )
            (princ "\n[VTACAD][ERR] Extraction or integrity check failed. Run VTA_DIAG for details.")
          )
        )
        (progn
          (VTA:Setup:EnsurePaths bundleDir contentsDir)
          (VTA:Setup:ReloadRibbon cuix)
          (vl-catch-all-apply 'load (list eng))
          (vl-catch-all-apply 'load (list toolsPath))
          (setq ok T)
        )
      )
    )
  )
  ok
)

(defun VTA:Setup:Run ()
  (VTA:Setup:Install nil)
  (princ)
)

(defun VTA:Setup:DoUninstall (/ bundleDir contentsDir fso exists psDir wsh)
  (setq bundleDir (VTA:Setup:AppDataBundle))
  (if (null bundleDir)
    (princ "\n[VTACAD][ERR] Cannot resolve %APPDATA% - uninstall aborted.")
    (progn
      (setq contentsDir (strcat bundleDir "\\Contents"))
      (VTA:Setup:UnloadRibbon contentsDir)
      (if (vl-file-directory-p bundleDir)
        (progn
          (setq fso (vl-catch-all-apply 'vlax-create-object (list "Scripting.FileSystemObject")))
          (if (and fso (not (vl-catch-all-error-p fso)))
            (progn
              (setq exists (vl-catch-all-apply 'vlax-invoke-method (list fso 'FolderExists bundleDir)))
              (if (and (not (vl-catch-all-error-p exists)) (equal exists :vlax-true))
                (vl-catch-all-apply 'vlax-invoke-method (list fso 'DeleteFolder bundleDir :vlax-true))
              )
              (vl-catch-all-apply 'vlax-release-object (list fso))
            )
          )
          (if (vl-file-directory-p bundleDir)
            (progn
              (setq psDir (VTA:Setup:ReplaceAll bundleDir "'" "''"))
              (VTA:Setup:PSRun
                (strcat "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item -LiteralPath '" psDir "' -Recurse -Force -ErrorAction SilentlyContinue\"")
              )
            )
          )
        )
      )
      (vl-catch-all-apply 'vl-registry-delete (list (VTA:Setup:RegKey) "InstalledVersion"))
      (vl-catch-all-apply 'vl-registry-delete (list (VTA:Setup:RegKey) "BundleDir"))
      (vl-catch-all-apply 'vl-registry-delete (list (VTA:Setup:RegKey)))
      (setq wsh (vl-catch-all-apply 'vlax-create-object (list "WScript.Shell")))
      (if (and wsh (not (vl-catch-all-error-p wsh)))
        (progn
          (vl-catch-all-apply 'vlax-invoke-method (list wsh 'RegDelete "HKCU\\Software\\VTAcad\\Setup\\"))
          (vl-catch-all-apply 'vlax-release-object (list wsh))
        )
      )
      (princ "\n==================================================================")
      (princ "\n[VTACAD] UNINSTALL COMPLETE:")
      (princ "\n - Ribbon menugroup VTACAD: unloaded.")
      (princ (strcat "\n - Bundle folder: " bundleDir
                     (if (vl-file-directory-p bundleDir) " [PARTIAL - restart AutoCAD]" " [REMOVED]")))
      (princ "\n - Setup registry key HKCU\\Software\\VTAcad\\Setup: removed.")
      (princ "\n - Restart AutoCAD to complete full cleanup.")
      (princ "\n==================================================================")
    )
  )
  (princ)
)

(defun c:VTA_REINSTALL ()
  (VTA:Setup:Install T)
  (princ)
)

(defun c:VTA_UPDATE ()
  (c:VTA_REINSTALL)
)

(defun c:VTA_REPAIR (/ bundleDir contentsDir eng cuix toolsPath)
  (setq bundleDir (VTA:Setup:AppDataBundle))
  (if (null bundleDir)
    (princ "\n[VTACAD][ERR] Cannot resolve %APPDATA% - repair aborted.")
    (progn
      (setq contentsDir (strcat bundleDir "\\Contents"))
      (setq eng (strcat contentsDir "\\VTACAD.fas"))
      (setq cuix (strcat contentsDir "\\VTACAD.cuix"))
      (setq toolsPath (strcat contentsDir "\\VTACAD_Tools.fas"))
      (if (and (findfile eng) (findfile cuix) (findfile toolsPath))
        (progn
          (princ "\n[VTACAD] Repairing paths, MNR cache, and ribbon CUIX...")
          (VTA:Setup:EnsurePaths bundleDir contentsDir)
          (VTA:Setup:UnloadRibbon contentsDir)
          (VTA:Setup:ReloadRibbon cuix)
          (vl-catch-all-apply 'load (list eng))
          (vl-catch-all-apply 'load (list toolsPath))
          (princ "\n[VTACAD] Ribbon, engine, and Pro Tools repair complete.")
        )
        (progn
          (princ "\n[VTACAD][WARN] Core files missing - running full reinstall...")
          (VTA:Setup:Install T)
        )
      )
    )
  )
  (princ)
)

(defun c:VTA_DIAG (/ bundleDir contentsDir eng cuix toolsPath xml regVer fasSize cuixSize toolsSize bmpCnt acadVal acadOk tpVal tpOk menuOk)
  (setq bundleDir (VTA:Setup:AppDataBundle))
  (if (null bundleDir)
    (princ "\n[VTACAD][ERR] Cannot resolve %APPDATA% - diagnostics aborted.")
    (progn
      (setq contentsDir (strcat bundleDir "\\Contents"))
      (setq eng (strcat contentsDir "\\VTACAD.fas"))
      (setq cuix (strcat contentsDir "\\VTACAD.cuix"))
      (setq toolsPath (strcat contentsDir "\\VTACAD_Tools.fas"))
      (setq xml (strcat bundleDir "\\PackageContents.xml"))
      (setq regVer (vl-catch-all-apply 'vl-registry-read (list (VTA:Setup:RegKey) "InstalledVersion")))
      (if (vl-catch-all-error-p regVer) (setq regVer nil))
      (setq fasSize (if (findfile eng) (vl-file-size eng) nil))
      (setq cuixSize (if (findfile cuix) (vl-file-size cuix) nil))
      (setq toolsSize (if (findfile toolsPath) (vl-file-size toolsPath) nil))
      (setq bmpCnt (VTA:Setup:CountBmp contentsDir))
      (setq acadVal (getenv "ACAD"))
      (setq acadOk (VTA:Setup:HasPathP acadVal contentsDir))
      (setq tpVal (vl-catch-all-apply 'getvar (list "TRUSTEDPATHS")))
      (if (and (not (vl-catch-all-error-p tpVal)) (= (type tpVal) 'STR))
        (setq tpOk (and (VTA:Setup:HasPathP tpVal contentsDir)
                        (VTA:Setup:HasPathP tpVal (strcat bundleDir "\\..."))))
        (setq tpOk "N/A")
      )
      (setq menuOk (if (menugroup "VTACAD") T nil))

      (princ "\n==================== VTACAD PRO v26.0 DIAGNOSTICS ====================")
      (princ (strcat "\n Package Version     : " *VTA:Setup:Version*))
      (princ (strcat "\n Registry Installed  : " (if regVer regVer "<not set>")))
      (princ (strcat "\n Bundle Directory    : " bundleDir
                     (if (vl-file-directory-p bundleDir) " [EXISTS]" " [MISSING]")))
      (princ (strcat "\n VTACAD.fas          : "
                     (if (findfile eng)
                       (strcat (if (equal fasSize *VTA:Setup:ExpectedFasSize*) "OK" "SIZE MISMATCH")
                               " (" (if fasSize (itoa fasSize) "0") " / expected " (itoa *VTA:Setup:ExpectedFasSize*) " bytes)")
                       "MISSING"
                     )))
      (princ (strcat "\n VTACAD.cuix         : "
                     (if (findfile cuix)
                       (strcat (if (equal cuixSize *VTA:Setup:ExpectedCuixSize*) "OK" "SIZE MISMATCH")
                               " (" (if cuixSize (itoa cuixSize) "0") " / expected " (itoa *VTA:Setup:ExpectedCuixSize*) " bytes)")
                       "MISSING"
                     )))
      (princ (strcat "\n VTACAD_Tools.fas    : "
                     (if (findfile toolsPath)
                       (strcat (if (equal toolsSize *VTA:Setup:ExpectedToolsSize*) "OK" "SIZE MISMATCH")
                               " (" (if toolsSize (itoa toolsSize) "0") " / expected " (itoa *VTA:Setup:ExpectedToolsSize*) " bytes)")
                       "MISSING"
                     )))
      (princ (strcat "\n PackageContents.xml : " (if (findfile xml) "OK [EXISTS]" "MISSING")))
      (princ (strcat "\n BMP Icons (Contents): " (itoa bmpCnt) " / expected " (itoa *VTA:Setup:ExpectedBmpCount*)
                     (if (= bmpCnt *VTA:Setup:ExpectedBmpCount*) " [OK]" " [INCOMPLETE]")))
      (princ (strcat "\n ACAD Support Path   : " (if acadOk "OK [REGISTERED]" "MISSING")))
      (princ (strcat "\n TRUSTEDPATHS        : "
                     (cond
                       ((= tpOk "N/A") "N/A (unsupported in this AutoCAD version)")
                       (tpOk "OK [REGISTERED]")
                       (T "MISSING")
                     )))
      (princ (strcat "\n VTACAD Menugroup    : " (if menuOk "LOADED" "NOT LOADED")))
      (princ "\n======================================================================")
    )
  )
  (princ)
)

