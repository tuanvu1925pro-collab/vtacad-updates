(defun c:VTA_SETUP (/ bundleDir contentsDir eng cuix toolsPath xml regVer fasSize cuixSize toolsSize bmpCnt acadOk tpVal tpOk menuOk dclFile dclId status verStr fasStr cuixStr toolsStr iconStr pathStr xmlStr)
  (setq bundleDir (VTA:Setup:AppDataBundle))
  (if (null bundleDir)
    (princ "\n[VTACAD][ERR] Cannot resolve %APPDATA% - cannot open setup manager.")
    (progn
      (setq contentsDir (strcat bundleDir "\\Contents"))
      (setq eng (strcat contentsDir "\\VTACAD.fas"))
      (setq cuix (strcat contentsDir "\\VTACAD.cuix"))
      (setq toolsPath (strcat contentsDir "\\VTACAD_Tools.fas"))
      (setq xml (strcat bundleDir "\\PackageContents.xml"))
      (setq regVer (vl-catch-all-apply 'vl-registry-read (list (VTA:Setup:RegKey) "InstalledVersion")))
      (if (vl-catch-all-error-p regVer) (setq regVer nil))
      (setq fasSize (if (findfile eng) (vl-file-size eng) nil))
      (setq cuixSize (if (findfile cuix) (vl-file-size cuix) nil))
      (setq toolsSize (if (findfile toolsPath) (vl-file-size toolsPath) nil))
      (setq bmpCnt (VTA:Setup:CountBmp contentsDir))
      (setq acadOk (VTA:Setup:HasPathP (getenv "ACAD") contentsDir))
      (setq tpVal (vl-catch-all-apply 'getvar (list "TRUSTEDPATHS")))
      (if (and (not (vl-catch-all-error-p tpVal)) (= (type tpVal) 'STR))
        (setq tpOk (if (and (VTA:Setup:HasPathP tpVal contentsDir)
                            (VTA:Setup:HasPathP tpVal (strcat bundleDir "\\...")))
                     "OK"
                     "MISSING"
                   ))
        (setq tpOk "N/A")
      )
      (setq menuOk (if (menugroup "VTACAD") "LOADED" "NOT LOADED"))
      (setq verStr (strcat "Pkg " *VTA:Setup:Version* " | Reg: "
                           (cond
                             ((equal regVer *VTA:Setup:Version*) (strcat regVer " [OK]"))
                             (regVer (strcat regVer " [OUTDATED]"))
                             (T "<not installed>")
                           )))
      (setq fasStr (if (findfile eng)
                     (strcat (if (equal fasSize *VTA:Setup:ExpectedFasSize*) "OK" "MISMATCH")
                             " (" (if fasSize (itoa fasSize) "0") " / " (itoa *VTA:Setup:ExpectedFasSize*) " bytes)")
                     "MISSING"))
      (setq cuixStr (if (findfile cuix)
                      (strcat (if (equal cuixSize *VTA:Setup:ExpectedCuixSize*) "OK" "MISMATCH")
                              " (" (if cuixSize (itoa cuixSize) "0") " / " (itoa *VTA:Setup:ExpectedCuixSize*) " bytes)")
                      "MISSING"))
      (setq toolsStr (if (findfile toolsPath)
                       (strcat (if (equal toolsSize *VTA:Setup:ExpectedToolsSize*) "OK" "MISMATCH")
                               " (" (if toolsSize (itoa toolsSize) "0") " / " (itoa *VTA:Setup:ExpectedToolsSize*) " bytes)")
                       "MISSING"))
      (setq iconStr (strcat (itoa bmpCnt) " / " (itoa *VTA:Setup:ExpectedBmpCount*) " BMP icons"
                            (if (= bmpCnt *VTA:Setup:ExpectedBmpCount*) " [OK]" " [INCOMPLETE]")))
      (setq pathStr (strcat "ACAD:" (if acadOk "OK" "MISSING")
                            " | Trusted:" tpOk
                            " | Menu:" menuOk))
      (setq xmlStr (if (findfile xml) "OK [PackageContents.xml present]" "MISSING"))

      (setq status 0)
      (setq dclFile (vl-filename-mktemp "vta_setup.dcl"))
      (if (VTA:Setup:CreateDiagDCL dclFile)
        (progn
          (setq dclId (load_dialog dclFile))
          (if (and dclId (>= dclId 0))
            (progn
              (if (new_dialog "vta_setup_mgr" dclId)
                (progn
                  (set_tile "st_ver" verStr)
                  (set_tile "st_fas" fasStr)
                  (set_tile "st_cuix" cuixStr)
                  (set_tile "st_tools" toolsStr)
                  (set_tile "st_icons" iconStr)
                  (set_tile "st_paths" pathStr)
                  (set_tile "st_xml" xmlStr)
                  (action_tile "btn_pro"       "(done_dialog 6)")
                  (action_tile "btn_checkupd"  "(done_dialog 7)")
                  (action_tile "btn_reinstall" "(done_dialog 1)")
                  (action_tile "btn_repair"    "(done_dialog 2)")
                  (action_tile "btn_diag"      "(done_dialog 3)")
                  (action_tile "btn_folder"    "(done_dialog 4)")
                  (action_tile "btn_uninstall" "(done_dialog 5)")
                  (action_tile "cancel"        "(done_dialog 0)")
                  (setq status (start_dialog))
                )
                (princ "\n[VTACAD][ERR] Cannot open DCL dialog vta_setup_mgr.")
              )
              (unload_dialog dclId)
            )
            (princ "\n[VTACAD][ERR] Cannot load temporary DCL dialog.")
          )
          (if (findfile dclFile) (vl-file-delete dclFile))
        )
        (princ "\n[VTACAD][ERR] Cannot create temporary DCL file.")
      )

      (cond
        ((= status 6) (if c:VTA_PRO (c:VTA_PRO) (princ "\n[VTACAD][ERR] Command VTA_PRO not loaded. Run Repair or Reinstall.")))
        ((= status 7) (if c:VTA_CHECKUPDATE (c:VTA_CHECKUPDATE) (princ "\n[VTACAD][ERR] Command VTA_CHECKUPDATE not loaded.")))
        ((= status 1) (c:VTA_REINSTALL))
        ((= status 2) (c:VTA_REPAIR))
        ((= status 3) (c:VTA_DIAG))
        ((= status 4)
         (if (vl-file-directory-p bundleDir)
           (if (not (and (boundp '*VTA_Pro_NoLaunch*) *VTA_Pro_NoLaunch*))
             (startapp "explorer" (strcat "\"" bundleDir "\""))
           )
           (princ (strcat "\n[VTACAD][INFO] Bundle folder does not exist yet: " bundleDir "\n Run VTA_REINSTALL to install."))
         )
        )
        ((= status 5) (VTA:Setup:DoUninstall))
      )
    )
  )
  (princ)
)

